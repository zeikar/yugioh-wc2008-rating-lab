# Local development against the Firebase emulators (no real project needed):
#   pnpm emulators   (terminal 1)
#   pnpm dev         (terminal 2)
VITE_USE_EMULATORS=true

# Real Firebase project (Project settings → General → Your apps → Web app).
# Leave VITE_USE_EMULATORS unset or false to use it.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
